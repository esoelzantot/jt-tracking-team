rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admins = Firebase Auth users whose uid is listed in /admins/{uid}.
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The team can search without signing in; only admins can change data.
    match /clients/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /agents/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /branches/{id} { allow read: if true; allow write: if isAdmin(); }

    match /admins/{uid}  { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
  }
}
